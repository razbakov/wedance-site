{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/docs"
    },
    {
      "source": "/docs/:p*",
      "destination": "/api/docs?p=:p*"
    },
    {
      "source": "/team",
      "destination": "/api/team"
    },
    {
      "source": "/team/product-steward",
      "destination": "/api/team-product-steward"
    }
  ],
  "functions": {
    "api/docs.js": {
      "includeFiles": "private/docs/**"
    }
  }
}
