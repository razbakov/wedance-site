{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://2026.wedance.vip/docs/organization",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://2026.wedance.vip/docs/organization",
      "permanent": true
    },
    {
      "source": "/roles",
      "destination": "https://2026.wedance.vip/docs/organization#join",
      "permanent": true
    },
    {
      "source": "/roles/:slug*",
      "destination": "https://2026.wedance.vip/docs/organization#join",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/docs"
    },
    {
      "source": "/docs/",
      "destination": "/api/docs"
    },
    {
      "source": "/docs/:p*/",
      "destination": "/api/docs?p=:p*"
    },
    {
      "source": "/docs/:p*",
      "destination": "/api/docs?p=:p*"
    },
    {
      "source": "/team",
      "destination": "/api/team"
    },
    {
      "source": "/team/product-steward",
      "destination": "/api/team-product-steward"
    }
  ],
  "functions": {
    "api/docs.js": {
      "includeFiles": "private/docs/**"
    }
  }
}
